---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScrollReveal from "../../components/animations/ScrollReveal.tsx";
import GetInTouchBanner from "../../components/common/GetInTouchBanner.tsx";
import T from "../../i18n/T.astro";

const base = import.meta.env.BASE_URL;
const articles = [
  {
    slug: "bbsd-first-year-anniversary",
    title: "BBSD - First Year Anniversary",
    titleZh: "BBSD 一周年纪念",
    date: "Nov 20, 2025",
    dateZh: "2025年11月20日",
    image: `${base}images/news/news-1.jpg`,
  },
  {
    slug: "our-company-signs-industry-university-research-strategic-cooperation-agreement-with-nantong-university",
    title:
      "Our Company Signs Industry-University-Research Strategic Cooperation Agreement with Nantong University",
    titleZh: "我司与南通大学签署产学研战略合作协议",
    date: "Apr 18, 2025",
    dateZh: "2025年4月18日",
    image: `${base}images/news/news-2.jpg`,
  },
  {
    slug: "launches-iso-9000-quality-management-system-certification",
    title:
      "BBSD (Jiangsu Nantong) Engineering Technology Co., Ltd. Officially Launches ISO 9000 Quality Management System Certification",
    titleZh:
      "BBSD（江苏南通）工程技术有限公司正式启动 ISO 9000 质量管理体系认证",
    date: "Jun 4, 2025",
    dateZh: "2025年6月4日",
    image: `${base}images/news/news-3.jpg`,
  },
  {
    slug: "successfully-holds-fire-safety-emergency-drill",
    title:
      "BBSD (Jiangsu Nantong) Engineering Technology Co., Ltd. Successfully Holds Fire Safety Emergency Drill",
    titleZh: "BBSD（江苏南通）工程技术有限公司成功举行消防安全应急演练",
    date: "Aug 27, 2025",
    dateZh: "2025年8月27日",
    image: `${base}images/news/news-4.jpg`,
  },
];
---

<BaseLayout title="Latest News - BBSD">
  <main>
    <!-- Hero -->
    <section
      class="relative flex flex-col items-center justify-center overflow-hidden px-5 pt-[150px] pb-20 md:px-[30px] lg:h-[900px] lg:pt-[200px] lg:pb-[125px]"
    >
      <img
        src={`${base}images/news/news-hero.jpg`}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
      />
      <!-- Tiled industrial texture (1200-wide centered band) -->
      <div
        class="absolute inset-y-0 left-1/2 w-full max-w-[1200px] -translate-x-1/2 bg-repeat"
        style={`background-image: url('${base}images/home/hero-pattern.png'); background-size: 1200px;`}
      >
      </div>
      <!-- Dark overlay for white-text contrast -->
      <div class="absolute inset-0 bg-black/35"></div>
      <div class="relative z-10 flex max-w-[600px] flex-col items-center gap-6 text-center">
        <h1
          class="text-[44px] font-semibold leading-[1.05] tracking-[-0.04em] text-white md:text-[56px] lg:text-[70px] lg:leading-[73.5px] lg:tracking-[-2.8px]"
        >
          <T en="Latest News" zh="最新动态" />
        </h1>
        <p
          class="text-base font-normal text-[#cccccc] lg:text-[18px] lg:leading-[30.6px] lg:tracking-[-0.36px]"
        >
          <T
            en="Stay updated with our latest company news, project milestones, and industry insights."
            zh="了解 BBSD 最新的公司动态、项目里程碑与行业洞察。"
          />
        </p>
      </div>
    </section>

    <!-- News grid -->
    <section
      class="flex flex-col items-center overflow-hidden bg-white px-5 pt-20 pb-16 md:px-[30px] lg:pt-[125px] lg:pb-[65px]"
    >
      <div class="grid w-full max-w-[1200px] grid-cols-1 gap-[30px] md:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((article, i) => (
            <ScrollReveal client:visible delay={i * 0.1}>
              <a
                href={`${base}news/${article.slug}`}
                class="group flex flex-col gap-[30px]"
              >
                <div class="relative overflow-hidden rounded-[15px]">
                  <img
                    src={article.image}
                    alt={article.title}
                    loading="lazy"
                    class="h-[312px] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div
                    class="absolute inset-0 flex items-center justify-center bg-black/45 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                  >
                    <svg
                      class="h-12 w-12 text-white"
                      viewBox="0 0 256 256"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"
                      ></path>
                    </svg>
                  </div>
                </div>
                <div class="flex flex-col gap-5">
                  <div class="flex flex-col gap-[5px]">
                    <p class="text-[14px] font-normal leading-[22.4px] tracking-[-0.28px] text-[#8c8c8c]">
                      <T en={article.date} zh={article.dateZh} />
                    </p>
                    <h4 class="text-[20px] font-semibold leading-[32px] tracking-[-0.4px] text-black">
                      <T en={article.title} zh={article.titleZh} />
                    </h4>
                  </div>
                  <span class="text-[16px] font-medium leading-[19.2px] text-blue-dark underline">
                    <T en="Read more →" zh="阅读更多 →" />
                  </span>
                </div>
              </a>
            </ScrollReveal>
          ))
        }
      </div>
    </section>

    <GetInTouchBanner client:visible />
  </main>
</BaseLayout>
