---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsArticle from "../../components/news/NewsArticle.astro";
import GetInTouchBanner from "../../components/common/GetInTouchBanner.tsx";
import T from "../../i18n/T.astro";
---

<BaseLayout title="BBSD - First Year Anniversary">
  <main>
    <NewsArticle
      date="Nov 20, 2025"
      dateZh="2025年11月20日"
      title="BBSD - First Year Anniversary"
      titleZh="BBSD 一周年纪念"
      cover="news-1.jpg"
    >
      <p>
        <T
          en="Today marks one year of BBSD. A year of growth, collaboration, and delivering reliable engineering solutions."
          zh="今天是 BBSD 成立一周年的日子。这一年里，我们不断成长、携手协作，交付可靠的工程解决方案。"
        />
      </p>
      <p>
        <T
          en="Thank you to our clients, partners, and team for the trust and hard work. Here's to building even better in the years ahead."
          zh="感谢我们的客户、合作伙伴与团队的信任与辛勤付出。愿我们在未来的岁月里建得更好。"
        />
      </p>
      <p>
        <strong>
          <T en="BBSD - One year strong!" zh="BBSD —— 一周年，再出发！" />
        </strong>
      </p>
    </NewsArticle>

    <GetInTouchBanner client:visible />
  </main>
</BaseLayout>
