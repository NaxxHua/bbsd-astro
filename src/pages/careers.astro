---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollReveal from "../components/animations/ScrollReveal.tsx";
import GetInTouchBanner from "../components/common/GetInTouchBanner.tsx";
import T from "../i18n/T.astro";

const base = import.meta.env.BASE_URL;
const positions = [
  {
    level: "Senior",
    levelZh: "高级",
    title: "Structural Design Engineer",
    titleZh: "结构设计工程师",
    date: "JAN 2026",
    dateZh: "2026年1月",
  },
  {
    level: "Senior",
    levelZh: "高级",
    title: "Piping Design Engineer",
    titleZh: "管道设计工程师",
    date: "NOVEMBER 2025",
    dateZh: "2025年11月",
  },
  {
    level: "Senior",
    levelZh: "高级",
    title: "Electrical & Instrumentation (E&I) Design Engineer",
    titleZh: "电气与仪表（E&I）设计工程师",
    date: "JUNE 2025",
    dateZh: "2025年6月",
  },
  {
    level: "Junior",
    levelZh: "初级",
    title: "Procurement Specialist",
    titleZh: "采购专员",
    date: "AUGUST 2025",
    dateZh: "2025年8月",
  },
];
---

<BaseLayout title="Careers - BBSD">
  <main>
    <!-- Hero -->
    <section class="relative h-screen w-full overflow-hidden">
      <img
        src={`${base}images/careers/hero.jpg`}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-black/40"></div>
      <div
        class="relative z-10 flex h-full flex-col items-center justify-center px-6 text-center"
      >
        <h1 class="text-6xl font-bold text-white/80 md:text-8xl">
          <T en="Careers" zh="招贤纳士" />
        </h1>
      </div>
    </section>

    <!-- Come Join -->
    <section class="bg-white py-20">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="grid items-center gap-12 md:grid-cols-2">
          <ScrollReveal client:visible>
            <div>
              <h2 class="mb-6 text-3xl font-bold text-dark md:text-4xl">
                <T en="Come join our team" zh="加入我们的团队" />
              </h2>
              <p class="text-sm leading-relaxed text-gray">
                <T
                  en="At BBSD, we design and deliver world-class offshore and marine engineering solutions. Our success is driven by talented professionals who are passionate about engineering excellence, safety, and innovation."
                  zh="在 BBSD，我们设计并交付世界一流的海洋与船舶工程解决方案。我们的成功源于热衷于卓越工程、安全与创新的优秀专业人才。"
                />
              </p>
              <p class="mt-4 text-sm leading-relaxed text-gray">
                <T
                  en="We offer a collaborative working environment, exposure to international offshore projects, and opportunities for long-term career development."
                  zh="我们提供协作的工作环境、参与国际海洋项目的机会，以及长期的职业发展空间。"
                />
              </p>
            </div>
          </ScrollReveal>
          <ScrollReveal client:visible>
            <img
              src={`${base}images/careers/team.jpg`}
              alt="Team at work"
              loading="lazy"
              class="w-full rounded-xl object-cover"
            />
          </ScrollReveal>
        </div>
      </div>
    </section>

    <!-- Open Positions -->
    <section class="bg-blue-light py-20">
      <div class="mx-auto max-w-[1200px] px-6">
        <h2 class="mb-10 text-3xl font-bold text-dark">
          <T en="Open Positions" zh="招聘职位" />
        </h2>

        <!-- Table Header -->
        <div class="mb-4 hidden grid-cols-3 gap-4 px-6 md:grid">
          <p
            class="text-xs font-semibold tracking-widest text-gray-light uppercase"
          >
            <T en="Level" zh="级别" />
          </p>
          <p
            class="text-xs font-semibold tracking-widest text-gray-light uppercase"
          >
            <T en="Title" zh="职位" />
          </p>
          <p
            class="text-xs font-semibold tracking-widest text-gray-light uppercase"
          >
            <T en="Date" zh="发布日期" />
          </p>
        </div>

        <div class="space-y-3">
          {
            positions.map((pos) => (
              <ScrollReveal client:visible>
                <div class="grid items-center gap-4 rounded-xl bg-white p-6 md:grid-cols-3">
                  <div>
                    <span class="inline-block rounded-full bg-blue-light px-3 py-1 text-xs font-medium text-blue-dark">
                      <T en={pos.level} zh={pos.levelZh} />
                    </span>
                  </div>
                  <h3 class="text-sm font-bold text-dark">
                    <T en={pos.title} zh={pos.titleZh} />
                  </h3>
                  <p class="text-sm text-gray-light">
                    <T en={pos.date} zh={pos.dateZh} />
                  </p>
                </div>
              </ScrollReveal>
            ))
          }
        </div>
      </div>
    </section>

    <GetInTouchBanner client:visible />
  </main>
</BaseLayout>
