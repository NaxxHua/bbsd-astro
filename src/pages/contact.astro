---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactInfo from "../components/contact/ContactInfo.tsx";
import T from "../i18n/T.astro";
const base = import.meta.env.BASE_URL;

const stripImages = ["contact-1.jpg", "contact-2.jpg", "contact-3.jpg"];
const mapSrc =
  "https://maps.google.com/maps?q=No.%20218%20Yongxing%20Road%2C%20Yongxing%20Sub-district%2C%20Chongchuan%20District%2C%20Nantong%2C%20Jiangsu%2C%20China&z=15&output=embed";
---

<BaseLayout title="Contact - BBSD">
  <main>
    <!-- Hero -->
    <section
      class="relative flex flex-col items-center justify-center overflow-hidden px-5 pt-[150px] pb-20 md:px-[30px] lg:h-[900px] lg:pt-[200px] lg:pb-[125px]"
    >
      <img
        src={`${base}images/contact/contact-hero.jpg`}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div
        class="absolute inset-y-0 left-1/2 w-full max-w-[1200px] -translate-x-1/2 bg-repeat"
        style={`background-image: url('${base}images/home/hero-pattern.png'); background-size: 1200px;`}
      >
      </div>
      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.44),rgba(0,0,0,0.43))]"
      >
      </div>
      <div class="relative z-10 flex max-w-[600px] flex-col items-center gap-6 text-center">
        <h1
          class="text-[44px] font-semibold leading-[1.05] tracking-[-0.04em] text-white md:text-[56px] lg:text-[70px] lg:leading-[73.5px] lg:tracking-[-2.8px]"
        >
          <T en="Contact" zh="联系我们" />
        </h1>
        <p
          class="text-base font-normal text-[#cccccc] lg:text-[18px] lg:leading-[30.6px] lg:tracking-[-0.36px]"
        >
          <T
            en="Contact BBSD today and take the first step towards reliable and professional solutions."
            zh="立即联系 BBSD，迈出通向可靠、专业解决方案的第一步。"
          />
        </p>
      </div>
    </section>

    <!-- Form + Contact info -->
    <section
      class="flex flex-col items-center justify-center bg-white px-5 py-20 md:px-[30px] lg:py-[125px]"
    >
      <div class="flex w-full max-w-[1200px] flex-col gap-12 lg:flex-row lg:gap-[100px]">
        <!-- Left: heading + info -->
        <div class="flex-1">
          <ContactInfo client:visible />
        </div>

        <!-- Right: message form -->
        <div class="flex flex-1 flex-col gap-10">
          <h2
            class="text-[24px] font-semibold leading-[33.6px] tracking-[-0.48px] text-black"
          >
            <T en="Send us a message" zh="给我们留言" />
          </h2>
          <form class="flex flex-col gap-[15px]">
            <label class="flex flex-col">
              <input
                type="text"
                name="Name"
                placeholder="Your name"
                data-ph-en="Your name"
                data-ph-zh="您的姓名"
                class="w-full rounded-[10px] border border-black/10 bg-white px-3 py-3 text-[14px] text-black outline-none placeholder:text-[#666666]"
              />
            </label>
            <label class="flex flex-col">
              <input
                type="email"
                name="Email"
                placeholder="name@gmail.com"
                data-ph-en="name@gmail.com"
                data-ph-zh="您的邮箱地址"
                class="w-full rounded-[10px] border border-black/10 bg-white px-3 py-3 text-[14px] text-black outline-none placeholder:text-[#666666]"
              />
            </label>
            <label class="flex flex-col">
              <textarea
                name="Message"
                rows="4"
                placeholder="How can we help?"
                data-ph-en="How can we help?"
                data-ph-zh="我们能为您做些什么？"
                class="w-full resize-y rounded-[10px] border border-black/10 bg-white px-3 py-3 text-[14px] text-black outline-none placeholder:text-[#666666]"
              ></textarea>
            </label>
            <button
              type="submit"
              class="mt-0 h-[55px] rounded-[10px] bg-orange-primary text-[16px] font-semibold text-black transition-colors hover:bg-orange-hover"
            >
              <T en="Send message" zh="发送留言" />
            </button>
          </form>
        </div>
      </div>
    </section>

    <!-- Auto-scrolling image strip -->
    <section class="w-full overflow-hidden">
      <div class="marquee-track flex w-max gap-[10px]">
        {
          [...stripImages, ...stripImages].map((img) => (
            <img
              src={`${base}images/contact/${img}`}
              alt=""
              loading="lazy"
              class="h-[264px] w-[394px] shrink-0 rounded-[10px] object-cover"
            />
          ))
        }
      </div>
    </section>

    <!-- Google Maps -->
    <section
      class="flex flex-col items-center justify-center bg-white px-5 py-20 md:px-[30px] lg:py-[125px]"
    >
      <div class="w-full max-w-[1200px] overflow-hidden">
        <iframe
          src={mapSrc}
          title="BBSD Nantong Office Location"
          loading="lazy"
          class="h-[500px] w-full border-0"></iframe>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .marquee-track {
    animation: contact-marquee 30s linear infinite;
  }
  @keyframes contact-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-1212px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
