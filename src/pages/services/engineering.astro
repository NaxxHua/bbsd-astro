---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GetInTouchBanner from "../../components/common/GetInTouchBanner.tsx";
import T from "../../i18n/T.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Engineering Services - BBSD">
  <main>
    <!-- Hero -->
    <section class="relative h-[60vh] min-h-[400px] w-full overflow-hidden">
      <img
        src={`${base}images/services/service-1.jpg`}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-black/50"></div>
      <div
        class="relative z-10 flex h-full flex-col items-center justify-center px-6 text-center"
      >
        <h1 class="mb-4 text-4xl font-bold text-white md:text-6xl">
          <T en="Engineering Services" zh="工程服务" />
        </h1>
        <p class="max-w-2xl text-lg text-white/80">
          <T
            en="Comprehensive engineering solutions from concept to detailed design."
            zh="从概念到详细设计的全面工程解决方案。"
          />
        </p>
      </div>
    </section>

    <!-- Quick Nav -->
    <section class="border-b border-gray-light/20 bg-white">
      <div class="mx-auto flex max-w-[1200px] flex-wrap gap-4 px-6 py-4">
        <a
          href={`${base}engineering-services/structural-engineering`}
          class="rounded-full bg-blue-light px-4 py-2 text-sm font-medium text-blue-dark hover:bg-blue-dark hover:text-white transition-colors"
          ><T en="Structural Engineering" zh="结构工程" /></a
        >
        <a
          href={`${base}engineering-services/piping-engineering`}
          class="rounded-full bg-blue-light px-4 py-2 text-sm font-medium text-blue-dark hover:bg-blue-dark hover:text-white transition-colors"
          ><T en="Piping Engineering" zh="管道工程" /></a
        >
        <a
          href={`${base}engineering-services/mechanical-engineering`}
          class="rounded-full bg-blue-light px-4 py-2 text-sm font-medium text-blue-dark hover:bg-blue-dark hover:text-white transition-colors"
          ><T en="Mechanical Engineering" zh="机械工程" /></a
        >
        <a
          href={`${base}engineering-services/e-i-engineering`}
          class="rounded-full bg-blue-light px-4 py-2 text-sm font-medium text-blue-dark hover:bg-blue-dark hover:text-white transition-colors"
          ><T en="Electrical & Instrumentation" zh="电气与仪表" /></a
        >
      </div>
    </section>

    <!-- Content -->
    <section class="bg-white py-20">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="grid gap-16">
          <div class="grid items-start gap-8 md:grid-cols-2">
            <div>
              <h2 class="mb-4 text-2xl font-bold text-dark">
                <T en="Structural Engineering" zh="结构工程" />
              </h2>
              <p class="text-sm leading-relaxed text-gray">
                <T
                  en="BBSD provides structural design and analysis for offshore, onshore, and utility projects. We specialize in steel and structures, seismic analysis, and load-bearing assessments. Our approach emphasizes safety, durability, and compliance with global engineering standards."
                  zh="BBSD 为海上、陆上及公用工程项目提供结构设计与分析服务。我们专注于钢结构、抗震分析与承载能力评估，注重安全性、耐久性，并符合全球工程标准。"
                />
              </p>
            </div>
            <img
              src={`${base}images/services/service-2.jpg`}
              alt="Structural Engineering"
              loading="lazy"
              class="w-full rounded-xl object-cover"
            />
          </div>

          <div class="grid items-start gap-8 md:grid-cols-2">
            <img
              src={`${base}images/services/service-3.jpg`}
              alt="Piping Design"
              loading="lazy"
              class="order-2 w-full rounded-xl object-cover md:order-1"
            />
            <div class="order-1 md:order-2">
              <h2 class="mb-4 text-2xl font-bold text-dark">
                <T en="Piping Design & Routing" zh="管道设计与布管" />
              </h2>
              <p class="text-sm leading-relaxed text-gray">
                <T
                  en="Our piping design services cover concept to detailed engineering, including routing optimization, stress analysis, and 3D modeling. We ensure compliance with international codes (ASME, ISO) and deliver cost-effective, safe, and maintainable piping systems for energy and infrastructure projects."
                  zh="我们的管道设计服务涵盖从概念到详细设计，包括布管优化、应力分析与三维建模。我们确保符合 ASME、ISO 等国际规范，为能源与基础设施项目交付经济、安全、易维护的管道系统。"
                />
              </p>
            </div>
          </div>

          <div class="grid items-start gap-8 md:grid-cols-2">
            <div>
              <h2 class="mb-4 text-2xl font-bold text-dark">
                <T en="Mechanical Engineering" zh="机械工程" />
              </h2>
              <p class="text-sm leading-relaxed text-gray">
                <T
                  en="Our mechanical engineering services cover equipment selection, design, and integration for process industries. We support rotating and static equipment, pressure vessels, and HVAC systems, ensuring reliable performance across project lifecycles."
                  zh="我们的机械工程服务涵盖流程工业的设备选型、设计与集成。我们支持动设备与静设备、压力容器及暖通空调系统，确保在项目全生命周期内稳定可靠的性能。"
                />
              </p>
            </div>
            <img
              src={`${base}images/services/service-4.jpg`}
              alt="Mechanical Engineering"
              loading="lazy"
              class="w-full rounded-xl object-cover"
            />
          </div>

          <div class="grid items-start gap-8 md:grid-cols-2">
            <img
              src={`${base}images/services/service-5.jpg`}
              alt="E&I Engineering"
              loading="lazy"
              class="order-2 w-full rounded-xl object-cover md:order-1"
            />
            <div class="order-1 md:order-2">
              <h2 class="mb-4 text-2xl font-bold text-dark">
                <T en="E&I Engineering" zh="电气与仪表工程" />
              </h2>
              <p class="text-sm leading-relaxed text-gray">
                <T
                  en="BBSD offers Electrical and Instrumentation (E&I) engineering services covering power generation and distribution, lighting, instrumentation, automation, and control systems, with a focus on safety, redundancy, and compliance with industry standards and regulations such as IEC, IEEE, API, and DNV."
                  zh="BBSD 提供电气与仪表（E&I）工程服务，涵盖发电与配电、照明、仪表、自动化与控制系统，注重安全性、冗余设计，并符合 IEC、IEEE、API、DNV 等行业标准与规范。"
                />
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <GetInTouchBanner client:visible />
  </main>
</BaseLayout>
