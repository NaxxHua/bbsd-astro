---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GetInTouchBanner from "../../components/common/GetInTouchBanner.tsx";
import T from "../../i18n/T.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Commissioning - BBSD">
  <main>
    <!-- Hero -->
    <section class="relative h-[60vh] min-h-[400px] w-full overflow-hidden">
      <img
        src={`${base}images/services/service-4.jpg`}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-black/50"></div>
      <div
        class="relative z-10 flex h-full flex-col items-center justify-center px-6 text-center"
      >
        <h1 class="mb-4 text-4xl font-bold text-white md:text-6xl">
          <T en="Commissioning" zh="调试" />
        </h1>
        <p class="max-w-2xl text-lg text-white/80">
          <T
            en="Ensuring systems operate safely, efficiently, and ready for handover."
            zh="确保系统安全、高效运行并具备移交条件。"
          />
        </p>
      </div>
    </section>

    <!-- Content -->
    <section class="bg-white py-20">
      <div class="mx-auto max-w-[1200px] px-6">
        <div class="mb-12">
          <h2 class="mb-4 text-2xl font-bold text-dark">
            <T en="Commissioning Support" zh="调试支持" />
          </h2>
          <p class="max-w-3xl text-sm leading-relaxed text-gray">
            <T
              en="BBSD provides comprehensive commissioning services to ensure systems and facilities are fully functional, safe, and compliant before handover. Our expertise covers the critical final phase of project delivery, minimizing risks and ensuring smooth start-up operations."
              zh="BBSD 提供全面的调试服务，确保系统与设施在移交前完全可用、安全且合规。我们的专业能力覆盖项目交付的关键收尾阶段，降低风险并确保顺利投产。"
            />
          </p>
        </div>

        <div class="grid gap-12 md:grid-cols-2">
          <div>
            <h3 class="mb-3 text-xl font-bold text-dark">
              <T en="Flange Management" zh="法兰管理" />
            </h3>
            <p class="text-sm leading-relaxed text-gray">
              <T
                en="We implement systematic flange management programs to guarantee leak-free start-up. By controlling flange assembly, torqueing, and documentation, we enhance safety, reduce operational risks, and ensure compliance with international standards."
                zh="我们实施系统化的法兰管理方案，确保无泄漏投产。通过控制法兰装配、扭矩与文档记录，我们提升安全性、降低运营风险，并确保符合国际标准。"
              />
            </p>
          </div>

          <div>
            <h3 class="mb-3 text-xl font-bold text-dark">
              <T en="Flushing & Chemical Cleaning" zh="冲洗与化学清洗" />
            </h3>
            <p class="text-sm leading-relaxed text-gray">
              <T
                en="Our flushing and chemical cleaning services remove construction debris, contaminants, and residues from piping and process systems. Using proven procedures and certified cleaning agents, we safeguard equipment performance, extend asset life, and prepare systems for efficient operation."
                zh="我们的冲洗与化学清洗服务可清除管道与工艺系统中的施工碎屑、污染物与残留物。采用成熟的工艺与合格的清洗剂，我们保障设备性能、延长资产寿命，并为系统高效运行做好准备。"
              />
            </p>
          </div>
        </div>
      </div>
    </section>

    <GetInTouchBanner client:visible />
  </main>
</BaseLayout>
