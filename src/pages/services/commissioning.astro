---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceHero from "../../components/services/ServiceHero.astro";
import GetInTouchBanner from "../../components/common/GetInTouchBanner.tsx";
import T from "../../i18n/T.astro";
const base = import.meta.env.BASE_URL;

const blocks = [
  {
    h3En: "Flange Management",
    h3Zh: "法兰管理",
    pEn: "We implement systematic flange management programs to guarantee leak-free start-up. By controlling flange assembly, torqueing, and documentation, we enhance safety, reduce operational risks, and ensure compliance with international standards.",
    pZh: "我们实施系统化的法兰管理方案,确保无泄漏启动。通过把控法兰装配、紧固与记录,我们提升安全性、降低运行风险,并确保符合国际标准。",
  },
  {
    h3En: "Flushing & Chemical Cleaning",
    h3Zh: "冲洗与化学清洗",
    pEn: "Our flushing and chemical cleaning services remove construction debris, contaminants, and residues from piping and process systems. Using proven procedures and certified cleaning agents, we safeguard equipment performance, extend asset life, and prepare systems for efficient operation.",
    pZh: "我们的冲洗与化学清洗服务清除管道及工艺系统中的施工碎屑、污染物与残留物。我们采用成熟的工艺与认证清洗剂,保障设备性能、延长资产寿命,并为系统的高效运行做好准备。",
  },
];
---

<BaseLayout title="Commissioning - BBSD">
  <main>
    <ServiceHero
      title="Commissioning"
      titleZh="调试"
      subtitle="Ensuring systems operate safely, efficiently, and ready for handover"
      subtitleZh="确保系统安全、高效运行并具备移交条件"
      image="hero-commissioning.jpg"
    />

    <section class="flex flex-col items-center bg-white px-5 py-14 md:px-[30px] lg:py-[60px]">
      <div class="flex w-full max-w-[1200px] flex-col gap-10 lg:flex-row lg:gap-[75px]">
        <div class="w-full lg:w-[346px] lg:shrink-0">
          <img
            src={`${base}images/services/comm-detail.jpg`}
            alt="BBSD commissioning support"
            loading="lazy"
            class="h-[300px] w-full object-cover lg:h-[500px]"
          />
        </div>
        <div class="service-body flex flex-1 flex-col gap-7">
          <div class="flex flex-col gap-2">
            <h3>
              <T en="Commissioning Support" zh="调试支持" />
            </h3>
            <p>
              <T
                en="BBSD provides comprehensive commissioning services to ensure systems and facilities are fully functional, safe, and compliant before handover. Our expertise covers the critical final phase of project delivery, minimizing risks and ensuring smooth start-up operations."
                zh="BBSD 提供全面的调试服务,确保系统与设施在移交前完全可用、安全且合规。我们的专业能力覆盖项目交付的关键收尾阶段,降低风险并确保平稳的启动运行。"
              />
            </p>
          </div>
          {
            blocks.map((b) => (
              <div class="flex flex-col gap-2">
                <h3>
                  <T en={b.h3En} zh={b.h3Zh} />
                </h3>
                <p>
                  <T en={b.pEn} zh={b.pZh} />
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <GetInTouchBanner client:visible />
  </main>
</BaseLayout>
