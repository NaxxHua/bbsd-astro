---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EngServiceLayout from "../../components/services/EngServiceLayout.astro";
import GetInTouchBanner from "../../components/common/GetInTouchBanner.tsx";
import T from "../../i18n/T.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Piping Engineering - BBSD">
  <main>
    <EngServiceLayout
      title="Piping Engineering"
      titleZh="管道工程"
      prev={{
        label: "Mechanical Engineering",
        labelZh: "机械工程",
        href: "engineering-services/mechanical-engineering",
      }}
      next={{
        label: "Structural Engineering",
        labelZh: "结构工程",
        href: "engineering-services/structural-engineering",
      }}
    >
      <h5>
        <T
          en="BBSD offers piping engineering services for both onshore and offshore plants. The piping engineering services includes but not limited to:"
          zh="BBSD 为陆上及海上工厂提供管道工程服务。管道工程服务包括但不限于:"
        />
      </h5>
      <ul>
        <li><T en="Piping Materials Specification" zh="管道材料规格" /></li>
        <li>
          <T
            en="Plant Layout Design & Piping Routing"
            zh="工厂布置设计与管道走向"
          />
        </li>
        <li><T en="Piping Stress Analysis" zh="管道应力分析" /></li>
      </ul>
      <p>
        <T
          en="Piping Materials includes defining material classes, corrosion control strategies, and specifications for pipes, fittings, flanges, valves, and gaskets. For offshore projects, our engineers are familiar with harsh marine environments, high pressures, extreme temperatures, and weight optimization while adhering to codes like ASME, API, and ISO."
          zh="管道材料包括定义材料等级、腐蚀控制策略,以及管道、管件、法兰、阀门与垫片的规格。对于海上项目,我们的工程师熟悉严苛的海洋环境、高压、极端温度与重量优化,并遵循 ASME、API、ISO 等规范。"
        />
      </p>
      <ul>
        <li>
          <T
            en="Material Selection & Specification for pipes, fittings, flanges, gaskets, valves, and special items"
            zh="管道、管件、法兰、垫片、阀门及特殊件的材料选型与规格"
          />
        </li>
        <li>
          <T
            en="Documentation and Specification Development (PMS, MSD, MRs and Valve Datasheets)"
            zh="文件与规格编制(PMS、MSD、MR 及阀门数据表)"
          />
        </li>
        <li><T en="Procurement Support" zh="采购支持" /></li>
        <li>
          <T
            en="Coordination & Interface Management"
            zh="协调与接口管理"
          />
        </li>
      </ul>
      <img
        src={`${base}images/engineering-services/piping-1.jpg`}
        alt="Piping materials"
        loading="lazy"
      />
      <p>
        <T
          en="Piping Routing is the pivot discipline for offshore plant design. The piping design focuses on developing efficient, safe, and maintainable piping systems within the limited space of offshore facilities. It involves creating optimized layouts that balance process requirements, safety regulations, structural constraints, and accessibility. BBSD offers design activities from Single Function Module to Entire Plant like Full FPSO Topside."
          zh="管道走向是海上工厂设计的核心专业。管道设计致力于在海上设施有限的空间内开发高效、安全、易维护的管道系统,需要在工艺要求、安全规范、结构约束与可达性之间取得平衡,创建优化的布置方案。BBSD 提供从单功能模块到整厂(如完整 FPSO 上部模块)的设计服务。"
        />
      </p>
      <ul>
        <li><T en="Plant Layout Development" zh="工厂布置开发" /></li>
        <li><T en="Pipe Routing Design" zh="管道走向设计" /></li>
        <li>
          <T
            en="3D Modelling using cutting edge tools like E3D and PDMS"
            zh="使用 E3D、PDMS 等前沿工具进行三维建模"
          />
        </li>
        <li>
          <T
            en="Interface and Coordination (Design Review and Clash Check)"
            zh="接口与协调(设计评审与碰撞检查)"
          />
        </li>
      </ul>
      <p>
        <T
          en="Piping Stress discipline ensure that piping systems can safely withstand internal pressures, thermal expansion, dynamic loads, and external forces while meeting code and project requirements. This discipline involves analyzing piping flexibility, support design, and load transfer to equipment and structures using tools like CAESAR II or AutoPIPE. Piping Stress Analysis services includes following but not limited to:"
          zh="管道应力专业确保管道系统能够安全承受内压、热膨胀、动荷载与外力,同时满足规范与项目要求。该专业使用 CAESAR II、AutoPIPE 等工具分析管道柔性、支吊架设计以及对设备与结构的荷载传递。管道应力分析服务包括但不限于:"
        />
      </p>
      <ul>
        <li><T en="Piping Stress Analysis" zh="管道应力分析" /></li>
        <li>
          <T
            en="Support Design and Optimization"
            zh="支吊架设计与优化"
          />
        </li>
        <li>
          <T
            en="Equipment Nozzle Load Evaluation"
            zh="设备管嘴荷载评估"
          />
        </li>
      </ul>
      <img
        src={`${base}images/engineering-services/piping-2.png`}
        alt="Piping stress analysis"
        loading="lazy"
      />
    </EngServiceLayout>

    <GetInTouchBanner client:visible />
  </main>
</BaseLayout>
