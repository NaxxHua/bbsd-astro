---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceHero from "../../components/services/ServiceHero.astro";
import GetInTouchBanner from "../../components/common/GetInTouchBanner.tsx";
import T from "../../i18n/T.astro";
const base = import.meta.env.BASE_URL;

const cards = [
  {
    en: "Structural Engineering",
    zh: "结构工程",
    image: "eng-structural.jpg",
    href: "engineering-services/structural-engineering",
  },
  {
    en: "Piping Engineering",
    zh: "管道工程",
    image: "eng-piping.jpg",
    href: "engineering-services/piping-engineering",
  },
  {
    en: "Mechanical Engineering",
    zh: "机械工程",
    image: "eng-mechanical.jpg",
    href: "engineering-services/mechanical-engineering",
  },
  {
    en: "Electrical & Instrumentation",
    zh: "电气与仪表",
    image: "eng-ei.jpg",
    href: "engineering-services/e-i-engineering",
  },
];
---

<BaseLayout title="Engineering Services - BBSD">
  <main>
    <ServiceHero
      title="Engineering Services"
      titleZh="工程服务"
      subtitle="Specialist engineering across structural, piping, mechanical, and E&I disciplines."
      subtitleZh="涵盖结构、管道、机械与电气仪表专业的专项工程能力。"
      image="hero-engineering.jpg"
    />

    <section class="flex flex-col items-center bg-white px-5 py-16 md:px-[30px] lg:py-20">
      <div class="grid w-full max-w-[960px] grid-cols-2 gap-5 lg:grid-cols-4">
        {
          cards.map((card) => (
            <a
              href={`${base}${card.href}`}
              class="group relative h-[250px] overflow-hidden rounded-[20px]"
            >
              <img
                src={`${base}images/services/${card.image}`}
                alt={card.en}
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0)_40%,rgba(0,0,0,0.55)_100%)]" />
              <h3 class="absolute top-5 left-5 right-5 font-inter text-[22px] font-normal leading-[1.1] tracking-[-0.44px] text-white">
                <T en={card.en} zh={card.zh} />
              </h3>
              <span class="absolute right-4 bottom-4 text-white">
                <svg width="40" height="40" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
                  <path d="M128,80a48,48,0,1,0,48,48A48.06,48.06,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Zm95.68-93.85L135.68,18a15.88,15.88,0,0,0-15.36,0l-88,48.17a16,16,0,0,0-8.32,14v95.64a16,16,0,0,0,8.32,14l88,48.17a15.88,15.88,0,0,0,15.36,0l88-48.17h0a16,16,0,0,0,8.32-14V80.18A16,16,0,0,0,223.68,66.15ZM128,224,40,175.82V80.18L128,32l88,48.17v95.64Z" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <GetInTouchBanner client:visible />
  </main>
</BaseLayout>
