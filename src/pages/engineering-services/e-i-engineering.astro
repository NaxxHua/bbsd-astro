---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EngServiceLayout from "../../components/services/EngServiceLayout.astro";
import GetInTouchBanner from "../../components/common/GetInTouchBanner.tsx";
import T from "../../i18n/T.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="E&I Engineering - BBSD">
  <main>
    <EngServiceLayout
      title="E&I Engineering"
      titleZh="电气与仪表工程"
      next={{
        label: "Mechanical Engineering",
        labelZh: "机械工程",
        href: "engineering-services/mechanical-engineering",
      }}
    >
      <h5>
        <T
          en="BBSD offers Electrical and Instrumentation (E&I) engineering services covers power generation and distribution, lighting, instrumentation, automation, and control systems, with a focus on safety, redundancy, and compliance with industry standards and regulations such as IEC, IEEE, API, and DNV. Our competences are summarized as follows but not limited to:"
          zh="BBSD 提供电气与仪表(E&I)工程服务,涵盖发电与配电、照明、仪表、自动化及控制系统,注重安全性、冗余性,并遵循 IEC、IEEE、API、DNV 等行业标准与规范。我们的能力概括如下,但不限于此:"
        />
      </h5>
      <ul>
        <li><T en="Electrical System Design" zh="电气系统设计" /></li>
        <li>
          <T
            en="Instrumentation & Control Design"
            zh="仪表与控制设计"
          />
        </li>
        <li>
          <T
            en="3D Modeling & Layout Integration"
            zh="三维建模与布置集成"
          />
        </li>
      </ul>
      <img
        src={`${base}images/engineering-services/ei-1.jpg`}
        alt="Electrical system design"
        loading="lazy"
      />
      <p>
        <T
          en="Electrical Design designs the Electrical power generation and distribution. Its work starts with inventory of all consumers in the electrical consumer list, along with hidden consumers such as packages and machinery auxiliaries, e.g., lube oil heater and pumpers. HVAC, lighting and small power of Local Equipment Room, heat tracing, instrumented valves, etc. The definition of electrical equipment includes:"
          zh="电气设计负责发电与配电的设计。其工作从盘点电气用电设备清单中的所有用电设备开始,同时还包括隐性用电设备,如成套设备与机械辅助设备(例如润滑油加热器与泵),以及暖通空调(HVAC)、本地设备间的照明与小功率用电、伴热、带仪表阀门等。电气设备的定义包括:"
        />
      </p>
      <ul>
        <li>
          <T
            en="Switchgear, transformers, MCCs, VFDs, and cabling."
            zh="开关柜、变压器、电动机控制中心(MCC)、变频器(VFD)及电缆。"
          />
        </li>
        <li>
          <T
            en="Primary and secondary power distribution networks (HV, MV, LV)"
            zh="一次与二次配电网络(高压、中压、低压)"
          />
        </li>
        <li>
          <T
            en="Define lighting, grounding, and earthing systems for hazardous areas"
            zh="为危险区域定义照明、接地与防雷接地系统"
          />
        </li>
      </ul>
      <p>
        <T
          en="Instrument Design develops control philosophies for process automation, safety shutdown, and emergency systems and ensure compliances with IEC and DNV standards."
          zh="仪表设计为工艺自动化、安全停车与应急系统制定控制理念,并确保符合 IEC 与 DNV 标准。"
        />
      </p>
      <ul>
        <li>
          <T
            en="Define architecture for DCS, ESD, F&G (Fire & Gas), PAGA and SCADA system"
            zh="定义 DCS、ESD、F&G(火气)、PAGA 与 SCADA 系统的架构"
          />
        </li>
        <li>
          <T
            en="Select field instruments such as transmitters, analyzers, control valves, and sensors"
            zh="选择变送器、分析仪、控制阀、传感器等现场仪表"
          />
        </li>
        <li>
          <T
            en="Specify smart instrumentation and communication protocols (e.g., HART, Foundation Fieldbus)"
            zh="确定智能仪表与通信协议(如 HART、Foundation Fieldbus)"
          />
        </li>
      </ul>
      <p>
        <T
          en="3D Modelling is the key for offshore plant design which requires complicated multidisciplinary coordination with piping layout design, mechanical Equipment and Structural Design:"
          zh="三维建模是海上工厂设计的关键,需要与管道布置设计、机械设备及结构设计进行复杂的多专业协调:"
        />
      </p>
      <ul>
        <li>
          <T
            en="Define routing and layout for electrical cables, cable trays, junction boxes, and control panels"
            zh="定义电缆、电缆桥架、接线箱与控制盘的走向与布置"
          />
        </li>
        <li>
          <T
            en="Integrate instrument location plans and cable schedules into 3D models (e.g., Aveva E3D, SmartPlant)"
            zh="将仪表位置图与电缆清册集成到三维模型中(如 Aveva E3D、SmartPlant)"
          />
        </li>
        <li>
          <T
            en="Perform clash detection with piping, structural, and mechanical systems"
            zh="对管道、结构与机械系统进行碰撞检查"
          />
        </li>
        <li>
          <T
            en="Optimize layouts for space constraints, accessibility, and maintainability"
            zh="针对空间约束、可达性与可维护性优化布置"
          />
        </li>
      </ul>
      <img
        src={`${base}images/engineering-services/ei-2.jpg`}
        alt="E&I 3D modelling"
        loading="lazy"
      />
    </EngServiceLayout>

    <GetInTouchBanner client:visible />
  </main>
</BaseLayout>
