---
import T from "../../i18n/T.astro";

interface Props {
  title: string;
  titleZh: string;
  subtitle?: string;
  subtitleZh?: string;
  image: string;
}
const { title, titleZh, subtitle, subtitleZh, image } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section
  class="relative flex flex-col items-center justify-center overflow-hidden px-5 pt-[150px] pb-20 md:px-[30px] lg:h-[900px] lg:pt-[200px] lg:pb-[125px]"
>
  <img
    src={`${base}images/services/${image}`}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.71),rgba(0,0,0,0.69))]"
  >
  </div>
  <div class="relative z-10 flex max-w-[700px] flex-col items-center gap-6 text-center">
    <h1
      class="text-[44px] font-semibold leading-[1.05] tracking-[-0.04em] text-white md:text-[56px] lg:text-[70px] lg:leading-[73.5px] lg:tracking-[-2.8px]"
    >
      <T en={title} zh={titleZh} />
    </h1>
    {
      subtitle && (
        <p class="text-base font-normal text-[#cccccc] lg:text-[18px] lg:leading-[30.6px] lg:tracking-[-0.36px]">
          <T en={subtitle} zh={subtitleZh ?? subtitle} />
        </p>
      )
    }
  </div>
</section>

<style is:global>
  .service-body h3 {
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    letter-spacing: -0.44px;
    color: #000;
  }
  .service-body p {
    font-size: 16px;
    font-weight: 400;
    line-height: 27.2px;
    letter-spacing: -0.32px;
    color: var(--color-gray);
  }
  @media (min-width: 1200px) {
    .service-body h3 {
      font-size: 22px;
      line-height: 33px;
    }
    .service-body p {
      font-size: 18px;
      line-height: 30.6px;
      letter-spacing: -0.36px;
    }
  }
</style>
