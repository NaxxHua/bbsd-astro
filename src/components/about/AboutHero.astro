---
import T from "../../i18n/T.astro";
const base = import.meta.env.BASE_URL;
---

<section
  class="relative flex flex-col items-center justify-center overflow-hidden px-5 pt-[150px] pb-20 md:px-[30px] lg:h-[900px] lg:pt-[200px] lg:pb-[125px]"
>
  <!-- Background image -->
  <img
    src={`${base}images/about/hero-bg.jpg`}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
  />
  <!-- Dark gradient overlay (71% -> 69% black) -->
  <div
    class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.71),rgba(0,0,0,0.69))]"
  >
  </div>

  <!-- Content -->
  <div class="relative z-10 flex max-w-[600px] flex-col items-center gap-6 text-center">
    <h1
      class="text-[44px] font-semibold leading-[1.05] tracking-[-0.04em] text-white md:text-[56px] lg:text-[70px] lg:leading-[73.5px] lg:tracking-[-2.8px]"
    >
      <T en="About Us" zh="关于我们" />
    </h1>
    <p
      class="text-base font-normal text-[#cccccc] lg:text-[18px] lg:leading-[30.6px] lg:tracking-[-0.36px]"
    >
      <T
        en="Our journey has been marked by continuous improvement, expansion of our service offerings and a relentless focus on customer satisfaction."
        zh="我们的发展历程，始终伴随着持续改进、服务范围的拓展，以及对客户满意度始终如一的专注。"
      />
    </p>
  </div>
</section>
