---
import T from "../../i18n/T.astro";
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="bg-white text-dark">
  <div class="mx-auto max-w-[1200px] px-5 py-12 md:px-6 md:py-16">
    <div class="grid gap-10 md:grid-cols-3 md:gap-12">
      <!-- Logo & Description -->
      <div>
        <a href={base}>
          <img src={`${base}images/home/logo.png`} alt="BBSD" class="mb-5 h-10 w-auto md:mb-6 md:h-12" />
        </a>
        <p class="text-xs leading-relaxed text-gray md:text-sm">
          <T
            en="BBSD delivers trusted engineering and site services for global energy and infrastructure projects"
            zh="BBSD 为全球能源与基础设施项目提供值得信赖的工程与现场服务"
          />
        </p>
      </div>

      <!-- Rotterdam Office -->
      <div>
        <h4 class="mb-3 text-base font-bold text-dark md:mb-4 md:text-lg">
          <T en="Rotterdam" zh="鹿特丹" />
        </h4>
        <address class="text-xs leading-relaxed text-gray not-italic md:text-sm">
          3356 LX<br />
          Buitendijks 53, Papendrecht
        </address>
        <a
          href="https://maps.google.com/?q=Buitendijks+53+Papendrecht"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-block text-xs font-medium text-blue-link hover:text-blue-dark md:mt-3 md:text-sm"
        >
          <T en="View on Google" zh="在 Google 地图查看" />
        </a>
      </div>

      <!-- Nantong Office -->
      <div>
        <h4 class="mb-3 text-base font-bold text-dark md:mb-4 md:text-lg">
          <T en="Nantong" zh="南通" />
        </h4>
        <address class="text-xs leading-relaxed text-gray not-italic md:text-sm">
          <T en="No. 218 Yongxing Road" zh="永兴路 218 号" /><br />
          <T
            en="Yongxing Sub-district, Chongchuan District, Nantong City, Jiangsu Province, China"
            zh="中国江苏省南通市崇川区永兴街道"
          />
        </address>
        <a
          href="https://maps.google.com/?q=218+Yongxing+Road+Nantong+Jiangsu"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-block text-xs font-medium text-blue-link hover:text-blue-dark md:mt-3 md:text-sm"
        >
          <T en="View on Google" zh="在 Google 地图查看" />
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-gray-light/20 pt-6 md:mt-12 md:flex-row md:pt-8"
    >
      <p class="text-xs text-gray-light">
        &copy; {year} - BBSD
      </p>
      <nav class="flex flex-wrap justify-center gap-4 text-xs md:gap-6 md:text-sm">
        <a href={base} class="text-gray transition-colors hover:text-dark"><T en="Home" zh="首页" /></a>
        <a href={`${base}about-us`} class="text-gray transition-colors hover:text-dark"><T en="About" zh="关于我们" /></a>
        <a href={`${base}contact`} class="text-gray transition-colors hover:text-dark"><T en="Contact" zh="联系我们" /></a>
        <a href={`${base}news`} class="text-gray transition-colors hover:text-dark"><T en="News" zh="新闻" /></a>
      </nav>
    </div>
  </div>
</footer>
