---
import T from "../../i18n/T.astro";
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="w-full bg-white px-5 pt-16 pb-10 md:px-[30px] lg:pt-[100px] lg:pb-[50px]">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-16 lg:gap-[100px]">
    <!-- Top: 4-col grid (col 1 spans 2) -->
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-[60px]">
      <!-- Logo & Description (spans 2 columns) -->
      <div class="flex flex-col gap-5 md:col-span-2">
        <a href={base} class="w-fit">
          <img src={`${base}images/home/logo.png`} alt="BBSD" class="h-14 w-auto md:h-[72px]" />
        </a>
        <p
          class="text-base font-normal text-gray lg:text-[18px] lg:leading-[30.6px] lg:tracking-[-0.36px]"
        >
          <T
            en="BBSD delivers trusted engineering and site services for global energy and infrastructure projects"
            zh="BBSD 为全球能源与基础设施项目提供值得信赖的工程与现场服务"
          />
        </p>
      </div>

      <!-- Rotterdam Office -->
      <div class="flex flex-col gap-5">
        <h4
          class="text-lg font-semibold text-black lg:text-[20px] lg:leading-[32px] lg:tracking-[-0.4px]"
        >
          <T en="Rotterdam" zh="鹿特丹" />
        </h4>
        <address
          class="text-[15px] leading-[1.7] tracking-[-0.32px] text-gray not-italic md:text-base"
        >
          3356 LX<br />
          Buitendijks 53, Papendrecht
        </address>
        <a
          href="https://maps.google.com/?q=Buitendijks+53+Papendrecht"
          target="_blank"
          rel="noopener noreferrer"
          class="w-fit text-base font-medium text-blue-dark"
        >
          <T en="View on Google" zh="在 Google 地图查看" />
        </a>
      </div>

      <!-- Nantong Office -->
      <div class="flex flex-col gap-5">
        <h4
          class="text-lg font-semibold text-black lg:text-[20px] lg:leading-[32px] lg:tracking-[-0.4px]"
        >
          <T en="Nantong" zh="南通" />
        </h4>
        <address
          class="text-[15px] leading-[1.7] tracking-[-0.32px] text-gray not-italic md:text-base"
        >
          <T en="No. 218 Yongxing Road" zh="永兴路 218 号" /><br />
          <T
            en="Yongxing Sub-district, Chongchuan District, Nantong City, Jiangsu Province, China"
            zh="中国江苏省南通市崇川区永兴街道"
          />
        </address>
        <a
          href="https://maps.google.com/?q=218+Yongxing+Road+Nantong+Jiangsu"
          target="_blank"
          rel="noopener noreferrer"
          class="w-fit text-base font-medium text-blue-dark"
        >
          <T en="View on Google" zh="在 Google 地图查看" />
        </a>
      </div>
    </div>

    <!-- Bottom row: copyright + mini nav -->
    <div class="flex flex-col gap-4 pt-[30px] md:flex-row md:items-center">
      <p
        class="flex-1 text-base font-normal tracking-[-0.32px] text-gray"
      >
        &copy; {year} - BBSD
      </p>
      <nav class="flex gap-6 text-base font-normal tracking-[-0.32px]">
        <a href={base} class="text-black"><T en="Home" zh="首页" /></a>
        <a href={`${base}about-us`} class="text-black"><T en="About" zh="关于我们" /></a>
        <a href={`${base}contact`} class="text-black"><T en="Contact" zh="联系我们" /></a>
      </nav>
    </div>
  </div>
</footer>
