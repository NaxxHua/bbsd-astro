---
import T from "../../i18n/T.astro";
const base = import.meta.env.BASE_URL;
---

<div
  class="fixed bottom-6 left-4 z-10 flex items-center gap-[10px] md:bottom-[94px] md:left-[20px]"
>
  <a
    href={`${base}contact`}
    class="flex items-center gap-1.5 rounded-[10px] bg-black px-[13px] py-[8px] font-instrument text-[15px] font-semibold tracking-[-0.3px] text-white shadow-[0_3px_5px_0_rgba(0,0,0,0.25)] transition-transform hover:scale-105"
  >
    <span class="text-xs">✦</span>
    <T en="Contact us" zh="联系我们" />
  </a>
  <a
    href={`${base}careers`}
    class="rounded-[10px] bg-white px-[13px] py-[8px] font-instrument text-[15px] font-semibold tracking-[-0.3px] text-black shadow-[0_3px_5px_0_rgba(0,0,0,0.25)] transition-transform hover:scale-105"
  >
    <T en="Join us" zh="加入我们" />
  </a>
</div>
